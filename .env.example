# Copy to .env and fill in what you use.

PORT=3000

# --- Search provider for "Official SAP sources" mode (pick one) ---
# Brave Search API: https://api-dashboard.search.brave.com  (monthly free credit, then pay per 1,000 queries)
BRAVE_API_KEY=
# Or a self-hosted SearXNG instance with JSON output enabled (free):
SEARXNG_URL=

# Domains searched in SAP mode (one search per domain per keyword)
SAP_DOMAINS=help.sap.com,learning.sap.com,community.sap.com,api.sap.com,www.sap.com

# Crawl limits
RESULTS_PER_DOMAIN=10
PAGES_TO_READ=8
FETCH_TIMEOUT_MS=9000
RESPECT_ROBOTS=true
USER_AGENT=SolutionAtlas/1.0 (+https://your-site.example; contact@your-site.example)

# Cache: repeat searches for the same keyword cost nothing for this many hours
CACHE_TTL_HOURS=168
